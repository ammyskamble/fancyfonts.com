---
// src/pages/contact.astro - Modern, interactive Contact Us page
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us ― FancyFonts.com | Support, Feedback & Inquiries"
  description="Have questions, font requests, or feedback? Get in touch with the FancyFonts.com team. We are here to help creators, gamers, and developers."
  keywords="contact fancy fonts, fancy text generator support, font suggestion, typography feedback, fancy fonts email"
>
  <Header />

  <main class="flex-grow py-12 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[var(--muted-foreground)] mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-purple-600 transition-colors">Home</a>
      <span>/</span>
      <span class="text-[var(--foreground)] font-medium">Contact Us</span>
    </nav>

    <!-- Header Title -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400 bg-purple-500/10 px-3.5 py-1.5 rounded-full border border-purple-500/20 inline-flex items-center gap-1.5 shadow-xs">
        <span>📬</span> Direct Communication
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-[var(--foreground)] mt-4 tracking-tight">
        Get in Touch With <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-500 via-indigo-500 to-pink-500">Our Team</span>
      </h1>
      <p class="text-base sm:text-lg text-[var(--muted-foreground)] mt-3 leading-relaxed">
        Have a question about Unicode characters, need help with copy-paste compatibility, or have a brilliant new font style suggestion? We would love to hear from you.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
      
      <!-- Contact Form (7 Cols) -->
      <div class="lg:col-span-7 rounded-3xl theme-panel border border-[var(--border)] p-6 sm:p-8 shadow-xs">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-2">Send Us a Message</h2>
        <p class="text-xs text-[var(--muted-foreground)] mb-6">
          Fill out the form below and our team will get back to you within 24–48 hours.
        </p>

        <!-- Success Notification Box (hidden initially) -->
        <div id="contact-success-banner" class="hidden mb-6 p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-sm flex items-start gap-3">
          <span class="text-lg">✅</span>
          <div>
            <div class="font-bold">Message sent successfully!</div>
            <div class="text-xs mt-0.5 text-emerald-600 dark:text-emerald-400">
              Thank you for reaching out. We have received your inquiry and will reply to your email shortly.
            </div>
          </div>
        </div>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-[var(--foreground)] mb-1.5">
                Your Name <span class="text-purple-500">*</span>
              </label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required 
                placeholder="Alex Morgan"
                class="w-full px-4 py-2.5 text-sm rounded-xl theme-well border border-[var(--border)] text-[var(--foreground)] placeholder-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-semibold text-[var(--foreground)] mb-1.5">
                Email Address <span class="text-purple-500">*</span>
              </label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required 
                placeholder="alex@example.com"
                class="w-full px-4 py-2.5 text-sm rounded-xl theme-well border border-[var(--border)] text-[var(--foreground)] placeholder-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
              />
            </div>
          </div>

          <div>
            <label for="contact-topic" class="block text-xs font-semibold text-[var(--foreground)] mb-1.5">
              Subject Topic <span class="text-purple-500">*</span>
            </label>
            <select 
              id="contact-topic" 
              name="topic" 
              required
              class="w-full px-4 py-2.5 text-sm rounded-xl theme-well border border-[var(--border)] text-[var(--foreground)] focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
            >
              <option value="general">General Question</option>
              <option value="suggestion">Suggest a New Font Style or Glyphs</option>
              <option value="bug">Report a Bug or Unicode Display Issue</option>
              <option value="partnership">Business & Partnership Inquiries</option>
              <option value="privacy">Privacy & Data Request</option>
            </select>
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-[var(--foreground)] mb-1.5">
              Subject Title <span class="text-purple-500">*</span>
            </label>
            <input 
              type="text" 
              id="contact-subject" 
              name="subject" 
              required 
              placeholder="E.g., Suggestion for Gothic Subscript font style"
              class="w-full px-4 py-2.5 text-sm rounded-xl theme-well border border-[var(--border)] text-[var(--foreground)] placeholder-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-purple-500 transition"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold text-[var(--foreground)] mb-1.5">
              Your Message <span class="text-purple-500">*</span>
            </label>
            <textarea 
              id="contact-message" 
              name="message" 
              rows="5" 
              required
              placeholder="Describe your inquiry, request, or issue with as much detail as possible..."
              class="w-full px-4 py-2.5 text-sm rounded-xl theme-well border border-[var(--border)] text-[var(--foreground)] placeholder-[var(--muted-foreground)] focus:outline-none focus:ring-2 focus:ring-purple-500 transition resize-none"
            ></textarea>
          </div>

          <div class="pt-2">
            <button 
              type="submit" 
              id="contact-submit-btn"
              class="w-full sm:w-auto px-8 py-3 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-semibold text-sm shadow-md hover:shadow-purple-500/25 hover:opacity-95 transition cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Send Message</span>
              <span>✉️</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Info & Direct Channels (5 Cols) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Direct Email Card -->
        <div class="rounded-3xl theme-panel border border-[var(--border)] p-6 shadow-xs">
          <h3 class="text-base font-bold text-[var(--foreground)] mb-4 flex items-center gap-2">
            <span>📮</span> Dedicated Inboxes
          </h3>
          <ul class="space-y-4 text-xs">
            <li class="flex flex-col">
              <span class="text-[var(--muted-foreground)] font-medium">General Support & Help:</span>
              <a href="mailto:support@fancyfonts.com" class="font-semibold text-purple-600 dark:text-purple-400 hover:underline mt-0.5 text-sm">
                support@fancyfonts.com
              </a>
            </li>
            <li class="flex flex-col">
              <span class="text-[var(--muted-foreground)] font-medium">Font & Feature Requests:</span>
              <a href="mailto:ideas@fancyfonts.com" class="font-semibold text-purple-600 dark:text-purple-400 hover:underline mt-0.5 text-sm">
                ideas@fancyfonts.com
              </a>
            </li>
            <li class="flex flex-col">
              <span class="text-[var(--muted-foreground)] font-medium">Partnerships & Collaborations:</span>
              <a href="mailto:partnerships@fancyfonts.com" class="font-semibold text-purple-600 dark:text-purple-400 hover:underline mt-0.5 text-sm">
                partnerships@fancyfonts.com
              </a>
            </li>
            <li class="flex flex-col">
              <span class="text-[var(--muted-foreground)] font-medium">Privacy & Legal Compliance:</span>
              <a href="mailto:privacy@fancyfonts.com" class="font-semibold text-purple-600 dark:text-purple-400 hover:underline mt-0.5 text-sm">
                privacy@fancyfonts.com
              </a>
            </li>
          </ul>
        </div>

        <!-- Response Time Card -->
        <div class="rounded-2xl theme-panel border border-[var(--border)] p-5 shadow-xs flex items-start gap-3.5">
          <span class="text-2xl flex-shrink-0">⚡</span>
          <div>
            <h4 class="font-bold text-sm text-[var(--foreground)]">Fast Turnaround</h4>
            <p class="text-xs text-[var(--muted-foreground)] mt-1 leading-relaxed">
              We monitor all inquiries Monday through Friday. Expected response time is under 24 to 48 business hours.
            </p>
          </div>
        </div>

        <!-- Quick FAQ Jump -->
        <div class="rounded-2xl theme-panel border border-purple-500/20 p-5 shadow-xs bg-purple-500/5 flex items-start gap-3.5">
          <span class="text-2xl flex-shrink-0">💡</span>
          <div>
            <h4 class="font-bold text-sm text-[var(--foreground)]">Need an Instant Answer?</h4>
            <p class="text-xs text-[var(--muted-foreground)] mt-1 leading-relaxed">
              Find answers to questions like "Can I copy Gothic fonts?", "How to make cursive text?", and "What is the Dior font?" in our FAQ.
            </p>
            <a href="/#faq" class="inline-flex items-center gap-1 text-xs font-bold text-purple-600 dark:text-purple-400 hover:underline mt-2">
              Browse 17 Common FAQs →
            </a>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const successBanner = document.getElementById('contact-success-banner');
    const submitBtn = document.getElementById('contact-submit-btn');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Sending...</span> <span>⏳</span>';
        }

        setTimeout(() => {
          if (successBanner) {
            successBanner.classList.remove('hidden');
            successBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          form.reset();
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Send Another Message</span> <span>✉️</span>';
          }
        }, 800);
      });
    }
  });
</script>
