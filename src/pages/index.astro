---
// index.astro - FancyFonts.com main entry page
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FancyFontApp from '../components/FancyFontApp';
import GuideSection from '../components/GuideSection.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Fancy Fonts Generator ― 55+ Free Fancy Text & Font Copy and Paste"
  description="Free fancy fonts generator: convert text into 55+ aesthetic fancy fonts, cursive letters copy and paste, and gothic font styles. Instant 1-click font copy and paste."
  showFaqSchema={true}
>
  <Header />
  
  <main class="flex-grow">
    <!-- Hero Title & Subheading -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4 text-center">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[var(--foreground)]">
        Fancy <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-500 via-indigo-500 to-pink-500">Fonts Generator</span>
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[var(--muted-foreground)] max-w-2xl mx-auto">
        Free fancy fonts generator & fancy text generator: convert plain words into 55+ aesthetic letter fonts, cursive letters, and gothic styles with instant 1-click font copy and paste.
      </p>
    </div>

    <!-- Core Interactive App -->
    <FancyFontApp client:load />

    <!-- Crawlable SEO & Educational Guide Section -->
    <GuideSection />

    <!-- SEO Optimized 17 FAQ Section with Structured Microdata -->
    <FAQSection />
  </main>

  <Footer />
</Layout>
