---
// src/pages/terms.astro - Comprehensive Terms & Conditions page
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms & Conditions ― FancyFonts.com | Terms of Service"
  description="Read the Terms and Conditions of FancyFonts.com. Understand your rights, permitted use, and service disclaimers when using our free Unicode fancy text generator."
  keywords="terms and conditions, terms of service, fancy fonts terms, unicode generator terms, user agreement"
>
  <Header />

  <main class="flex-grow py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[var(--muted-foreground)] mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-purple-600 transition-colors">Home</a>
      <span>/</span>
      <span class="text-[var(--foreground)] font-medium">Terms & Conditions</span>
    </nav>

    <!-- Header Title -->
    <div class="mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 bg-indigo-500/10 px-3.5 py-1.5 rounded-full border border-indigo-500/20 inline-flex items-center gap-1.5 shadow-xs mb-3">
        <span>📜</span> User Agreement
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--foreground)] tracking-tight">
        Terms & Conditions
      </h1>
      <p class="text-xs sm:text-sm text-[var(--muted-foreground)] mt-2">
        Last Updated: September 6, 2026 • Effective Date: January 1, 2026
      </p>
    </div>

    <!-- Quick Summary Box -->
    <div class="mb-12 p-6 sm:p-8 rounded-3xl theme-panel border border-indigo-500/30 bg-indigo-500/5 shadow-xs">
      <div class="flex items-start gap-4">
        <span class="text-3xl flex-shrink-0">⚖️</span>
        <div>
          <h2 class="text-lg font-bold text-[var(--foreground)]">Summary of Core Terms</h2>
          <p class="text-sm text-[var(--muted-foreground)] mt-2 leading-relaxed">
            FancyFonts.com is a free, web-based tool provided for personal, creative, and commercial text conversion. By using this website, you agree to use our tools responsibly, respect third-party platform rules, and acknowledge that the service is provided &ldquo;as is&rdquo; without warranties.
          </p>
        </div>
      </div>
    </div>

    <!-- Terms Body -->
    <div class="space-y-10 text-sm text-[var(--muted-foreground)] leading-relaxed">
      
      <!-- Section 1 -->
      <section class="rounded-2xl theme-panel border border-[var(--border)] p-6 sm:p-8 shadow-xs">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-3 flex items-center gap-2">
          <span>1.</span> Acceptance of Terms
        </h2>
        <p class="mb-3">
          These Terms & Conditions (&ldquo;Terms&rdquo;) constitute a legally binding agreement between you and FancyFonts.com (&ldquo;we,&rdquo; &ldquo;us,&rdquo; or &ldquo;our&rdquo;). By accessing, browsing, or using FancyFonts.com, you certify that you have read, understood, and agreed to be bound by these Terms.
        </p>
        <p>
          If you do not agree to these Terms, you must discontinue use of the website immediately.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="rounded-2xl theme-panel border border-[var(--border)] p-6 sm:p-8 shadow-xs">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-3 flex items-center gap-2">
          <span>2.</span> Description of the Service
        </h2>
        <p class="mb-3">
          FancyFonts.com provides an online Unicode text conversion utility that translates standard Latin alphanumeric characters into decorative Unicode glyphs (such as cursive script, gothic blackletter, double-struck, circled letters, and aesthetic borders).
        </p>
        <p>
          The service is provided free of charge for your convenience and does not require account creation or payment. We reserve the right to modify, update, or discontinue features at any time without prior notice.
        </p>
      </section>

      <!-- Section 3 -->
      <section class="rounded-2xl theme-panel border border-[var(--border)] p-6 sm:p-8 shadow-xs">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-3 flex items-center gap-2">
          <span>3.</span> Permitted and Prohibited Uses
        </h2>
        <p class="mb-3 font-semibold text-[var(--foreground)]">You are encouraged to use FancyFonts.com to:</p>
        <ul class="list-disc pl-5 space-y-1 mb-4">
          <li>Style personal social media bios, nicknames, posts, and captions (Instagram, TikTok, Twitter/X, Discord, YouTube, etc.).</li>
          <li>Design gaming clan tags, server channel titles, and creative messaging.</li>
          <li>Format titles and creative headers in personal or commercial graphic art and publications.</li>
        </ul>
        <p class="mb-3 font-semibold text-[var(--foreground)]">You agree NOT to use the service to:</p>
        <ul class="list-disc pl-5 space-y-1 mb-3">
          <li>Generate, promote, or distribute hate speech, harassment, threats, or illegal content.</li>
          <li>Engage in denial-of-service attacks, automated bot scraping that degrades site performance, or unauthorized reverse-engineering of our server architecture.</li>
          <li>Impersonate individuals or organizations deceptively using misleading character glyphs (homoglyph spoofing or phishing).</li>
        </ul>
      </section>

      <!-- Section 4 -->
      <section class="rounded-2xl theme-panel border border-[var(--border)] p-6 sm:p-8 shadow-xs">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-3 flex items-center gap-2">
          <span>4.</span> Intellectual Property & Unicode Rights
        </h2>
        <p class="mb-3">
          <strong>Unicode Standards:</strong> The character glyphs produced by our generator belong to the public Unicode Standard administered by the Unicode Consortium. You are free to copy, paste, and publish transformed text in personal and commercial endeavors without paying royalties to us.
        </p>
        <p>
          <strong>Website IP:</strong> All proprietary code, custom visual styling, logos, site copy, graphics, and trademarks belonging to FancyFonts.com are our intellectual property and are protected under international copyright and trademark laws.
        </p>
      </section>

      <!-- Section 5 -->
      <section class="rounded-2xl theme-panel border border-[var(--border)] p-6 sm:p-8 shadow-xs">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-3 flex items-center gap-2">
          <span>5.</span> Third-Party Trademarks Disclaimer
        </h2>
        <p class="mb-3">
          References on this website to third-party platforms—including but not limited to Instagram, TikTok, Discord, Roblox, Fortnite, WhatsApp, and Apple—are made strictly for identification and compatibility guidance.
        </p>
        <p>
          FancyFonts.com is an independent utility and is <strong>not affiliated with, sponsored by, or endorsed by</strong> any of these companies. All registered trademarks and service marks are the property of their respective owners.
        </p>
      </section>

      <!-- Section 6 -->
      <section class="rounded-2xl theme-panel border border-[var(--border)] p-6 sm:p-8 shadow-xs">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-3 flex items-center gap-2">
          <span>6.</span> Disclaimer of Warranties
        </h2>
        <p class="mb-3">
          FancyFonts.com is provided on an &ldquo;AS IS&rdquo; and &ldquo;AS AVAILABLE&rdquo; basis. We make no representations or warranties of any kind, express or implied, regarding:
        </p>
        <ul class="list-disc pl-5 space-y-1 mb-3">
          <li>The uninterrupted availability or error-free operation of the website.</li>
          <li>Whether all target platforms or third-party applications will display every Unicode character without rendering quirks or system substitution boxes (tofu squares).</li>
        </ul>
      </section>

      <!-- Section 7 -->
      <section class="rounded-2xl theme-panel border border-[var(--border)] p-6 sm:p-8 shadow-xs">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-3 flex items-center gap-2">
          <span>7.</span> Limitation of Liability
        </h2>
        <p>
          To the maximum extent permitted by applicable law, FancyFonts.com and its operators shall not be liable for any direct, indirect, incidental, consequential, or punitive damages arising from your access to, use of, or inability to use the service, including any platform restrictions or account actions imposed by third-party social media services.
        </p>
      </section>

      <!-- Section 8 -->
      <section class="rounded-2xl theme-panel border border-[var(--border)] p-6 sm:p-8 shadow-xs">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-3 flex items-center gap-2">
          <span>8.</span> Contact for Legal Inquiries
        </h2>
        <p class="mb-3">
          If you have legal questions regarding these Terms or intellectual property inquiries, please contact our legal department at:
        </p>
        <div class="mt-4 p-4 rounded-xl theme-well border border-[var(--border)] font-mono text-xs">
          Email: <a href="mailto:legal@fancyfonts.com" class="text-purple-600 dark:text-purple-400 hover:underline">legal@fancyfonts.com</a>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
